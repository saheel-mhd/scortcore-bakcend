DATABASE_URL="mongodb+srv://username:password@cluster.mongodb.net/database-name"
DATABASE_CONNECT_TIMEOUT_MS="10000"
JWT_SECRET="replace-with-a-strong-secret-at-least-32-characters"
JWT_EXPIRES_IN="7d"
JWT_ISSUER="scortcore-backend"
JWT_AUDIENCE="scortcore-clients"
BCRYPT_SALT_ROUNDS="12"
CORS_ORIGIN="http://localhost:3000"
REQUEST_BODY_LIMIT="10kb"
AUTH_RATE_LIMIT_WINDOW_MS="900000"
AUTH_RATE_LIMIT_MAX_REQUESTS="5"
PORT="3000"
