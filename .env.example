# Template only — never put real values in this file. It is tracked by git
# (see the `!.env.example` exception in .gitignore), so anything written here
# is published to the repository and its history.
#
# Copy to `.env` for local development: cp .env.example .env

# MongoDB Atlas connection string.
DATABASE_URL="mongodb+srv://username:password@cluster.mongodb.net/database-name"
DATABASE_CONNECT_TIMEOUT_MS="10000"

# Must be at least 32 characters — the server refuses to boot otherwise.
# Generate one with: openssl rand -base64 48
JWT_SECRET="replace-with-a-strong-secret-at-least-32-characters"
JWT_EXPIRES_IN="7d"
JWT_ISSUER="scortcore-backend"
JWT_AUDIENCE="scortcore-clients"

# Must be between 10 and 15.
BCRYPT_SALT_ROUNDS="12"

# Comma-separated. Needs both the storefront and backoffice origins.
CORS_ORIGIN="http://localhost:5173,http://localhost:5174,http://localhost:3000"

REQUEST_BODY_LIMIT="10kb"
AUTH_RATE_LIMIT_WINDOW_MS="900000"
AUTH_RATE_LIMIT_MAX_REQUESTS="5"
PORT="3000"

# Used once by `npm run seed:admin` to bootstrap the first admin account.
# Clear these after the initial seed.
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="ChangeMe!123"
