generator client {
  provider = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum Role {
  admin
  staff
  customer
}

enum OrderStatus {
  pending
  paid
  shipped
  delivered
}

enum PaymentStatus {
  pending
  paid
  failed
  refunded
}

enum ComplaintStatus {
  open
  in_progress
  resolved
  closed
}

enum CouponType {
  percentage
  fixed
}

enum InventoryMovementType {
  set
  increase
  decrease
  order
  purchase_order
}

enum PurchaseOrderStatus {
  pending
  ordered
  partially_received
  received
  cancelled
}

model User {
  id                String      @id @default(auto()) @map("_id") @db.ObjectId
  email             String      @unique
  password          String
  role              Role        @default(customer)
  orders            Order[]
  complaints        Complaint[] @relation("CustomerComplaints")
  complaintReplies  Complaint[] @relation("AdminComplaintReplies")
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
}

model Product {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  slug        String   @unique
  sku         String   @unique
  description String?
  price       Float
  stock       Int      @default(0)
  isActive    Boolean  @default(true)
  purchaseOrders PurchaseOrder[]
  inventoryMovements InventoryMovement[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([name])
  @@index([isActive])
}

model Order {
  id          String      @id @default(auto()) @map("_id") @db.ObjectId
  orderNumber String      @unique
  customerId  String      @db.ObjectId
  customer    User        @relation(fields: [customerId], references: [id])
  couponId    String?     @db.ObjectId
  coupon      Coupon?     @relation(fields: [couponId], references: [id])
  items       Json
  subtotalAmount Float
  discountAmount Float    @default(0)
  totalAmount Float
  status      OrderStatus @default(pending)
  payment     Payment?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([customerId])
  @@index([couponId])
  @@index([status])
  @@index([createdAt])
}

model Payment {
  id        String        @id @default(auto()) @map("_id") @db.ObjectId
  orderId   String        @unique @db.ObjectId
  order     Order         @relation(fields: [orderId], references: [id])
  amount    Float
  provider  String?
  reference String?
  status    PaymentStatus @default(pending)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([status])
  @@index([createdAt])
}

model Theme {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String   @unique
  slug      String   @unique
  config    Json
  isActive  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
}

model Homepage {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  key          String   @unique
  sections     Json
  banner       Json
  layoutConfig Json
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Complaint {
  id         String          @id @default(auto()) @map("_id") @db.ObjectId
  customerId String          @db.ObjectId
  customer   User            @relation("CustomerComplaints", fields: [customerId], references: [id])
  subject    String
  message    String
  adminReply String?
  repliedById String?        @db.ObjectId
  repliedBy  User?           @relation("AdminComplaintReplies", fields: [repliedById], references: [id])
  repliedAt  DateTime?
  status     ComplaintStatus @default(open)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  @@index([customerId])
  @@index([status])
  @@index([createdAt])
}

model Coupon {
  id                String     @id @default(auto()) @map("_id") @db.ObjectId
  code              String     @unique
  description       String?
  type              CouponType
  value             Float
  minOrderAmount    Float?
  maxDiscountAmount Float?
  isActive          Boolean    @default(true)
  expiresAt         DateTime?
  usageLimit        Int?
  usedCount         Int        @default(0)
  orders            Order[]
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  @@index([isActive])
  @@index([expiresAt])
}

model InventoryMovement {
  id             String                @id @default(auto()) @map("_id") @db.ObjectId
  productId      String                @db.ObjectId
  product        Product               @relation(fields: [productId], references: [id])
  type           InventoryMovementType
  quantityChange Int
  previousStock  Int
  nextStock      Int
  reason         String?
  referenceType  String?
  referenceId    String?
  createdAt      DateTime              @default(now())

  @@index([productId])
  @@index([type])
  @@index([createdAt])
}

model PurchaseOrder {
  id             String              @id @default(auto()) @map("_id") @db.ObjectId
  purchaseNumber String              @unique
  supplierName   String
  supplierEmail  String?
  supplierPhone  String?
  productId      String              @db.ObjectId
  product        Product             @relation(fields: [productId], references: [id])
  quantity       Int
  receivedQuantity Int               @default(0)
  unitCost       Float
  totalCost      Float
  status         PurchaseOrderStatus @default(pending)
  notes          String?
  orderedAt      DateTime            @default(now())
  receivedAt     DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([productId])
  @@index([status])
  @@index([orderedAt])
}
