generator client {
  provider = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum Role {
  admin
  staff
  customer
}

enum OrderStatus {
  pending
  paid
  shipped
  delivered
}

enum PaymentStatus {
  pending
  paid
  failed
  refunded
}

enum ComplaintStatus {
  open
  in_progress
  resolved
  closed
}

enum CouponType {
  percentage
  fixed
}

enum InventoryMovementType {
  set
  increase
  decrease
  order
  purchase_order
}

enum PurchaseOrderStatus {
  pending
  ordered
  partially_received
  received
  cancelled
}

model User {
  id                 String       @id @default(auto()) @map("_id") @db.ObjectId
  name               String?
  phone              String?
  email              String       @unique
  password           String
  role               Role         @default(customer)
  roleConfigId       String?      @db.ObjectId
  roleConfig         RoleConfig?  @relation(fields: [roleConfigId], references: [id])
  wishlistProductIds String[]     @db.ObjectId
  addresses          Address[]
  orders             Order[]
  complaints         Complaint[]  @relation("CustomerComplaints")
  complaintReplies   Complaint[]  @relation("AdminComplaintReplies")
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  @@index([roleConfigId])
}

model Address {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  customerId String   @db.ObjectId
  customer   User     @relation(fields: [customerId], references: [id])
  label      String?
  fullName   String
  phone      String?
  line1      String
  line2      String?
  city       String
  state      String?
  postalCode String
  country    String
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([customerId])
}

model Product {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  slug        String   @unique
  sku         String   @unique
  description String?
  price       Float
  isActive    Boolean  @default(true)
  cardImage     String?
  mainImage     String?
  galleryImages String[] @default([])
  variants    ProductVariant[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([name])
  @@index([isActive])
}

model ProductVariant {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  productId String   @db.ObjectId
  product   Product  @relation(fields: [productId], references: [id])
  unitId    String   @db.ObjectId
  unit      Unit     @relation(fields: [unitId], references: [id])
  stock     Int      @default(0)
  inventoryMovements InventoryMovement[]
  purchaseOrders     PurchaseOrder[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, unitId])
  @@index([productId])
  @@index([unitId])
}

model Order {
  id          String      @id @default(auto()) @map("_id") @db.ObjectId
  orderNumber String      @unique
  customerId  String      @db.ObjectId
  customer    User        @relation(fields: [customerId], references: [id])
  couponId    String?     @db.ObjectId
  coupon      Coupon?     @relation(fields: [couponId], references: [id])
  items       Json
  subtotalAmount Float
  discountAmount Float    @default(0)
  totalAmount Float
  status      OrderStatus @default(pending)
  payment     Payment?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([customerId])
  @@index([couponId])
  @@index([status])
  @@index([createdAt])
}

model Payment {
  id        String        @id @default(auto()) @map("_id") @db.ObjectId
  orderId   String        @unique @db.ObjectId
  order     Order         @relation(fields: [orderId], references: [id])
  amount    Float
  provider  String?
  reference String?
  status    PaymentStatus @default(pending)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([status])
  @@index([createdAt])
}

model Theme {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String   @unique
  slug      String   @unique
  config    Json
  isActive  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
}

model Homepage {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  key          String   @unique
  sections     Json
  banner       Json
  layoutConfig Json
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model HomepageSection {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  title        String
  description  String?
  type         String   @default("product")
  productIds   String[] @db.ObjectId
  bannerConfig Json?
  isActive     Boolean  @default(true)
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([isActive])
  @@index([displayOrder])
  @@index([type])
}

model ShopSection {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  title        String
  description  String?
  type         String   @default("grid")
  columns      Int      @default(4)
  productIds   String[] @db.ObjectId
  bannerConfig Json?
  isActive     Boolean  @default(true)
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([isActive])
  @@index([displayOrder])
  @@index([type])
}

model RoleConfig {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String   @unique
  description String?
  permissions Json
  isSystem    Boolean  @default(false)
  users       User[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Complaint {
  id         String          @id @default(auto()) @map("_id") @db.ObjectId
  customerId String          @db.ObjectId
  customer   User            @relation("CustomerComplaints", fields: [customerId], references: [id])
  subject    String
  message    String
  adminReply String?
  repliedById String?        @db.ObjectId
  repliedBy  User?           @relation("AdminComplaintReplies", fields: [repliedById], references: [id])
  repliedAt  DateTime?
  status     ComplaintStatus @default(open)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  @@index([customerId])
  @@index([status])
  @@index([createdAt])
}

model Coupon {
  id                String     @id @default(auto()) @map("_id") @db.ObjectId
  code              String     @unique
  description       String?
  type              CouponType
  value             Float
  minOrderAmount    Float?
  maxDiscountAmount Float?
  isActive          Boolean    @default(true)
  expiresAt         DateTime?
  usageLimit        Int?
  usedCount         Int        @default(0)
  orders            Order[]
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  @@index([isActive])
  @@index([expiresAt])
}

model InventoryMovement {
  id               String                @id @default(auto()) @map("_id") @db.ObjectId
  productVariantId String                @db.ObjectId
  productVariant   ProductVariant        @relation(fields: [productVariantId], references: [id])
  type             InventoryMovementType
  quantityChange   Int
  previousStock    Int
  nextStock        Int
  reason           String?
  referenceType    String?
  referenceId      String?
  createdAt        DateTime              @default(now())

  @@index([productVariantId])
  @@index([type])
  @@index([createdAt])
}

model UnitCategory {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String   @unique
  shortName   String   @unique
  description String?
  units       Unit[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Unit {
  id          String        @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  shortName   String
  description String?
  categoryId  String        @db.ObjectId
  category    UnitCategory  @relation(fields: [categoryId], references: [id])
  productVariants ProductVariant[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@unique([categoryId, shortName])
  @@index([categoryId])
}

model PurchaseOrder {
  id               String              @id @default(auto()) @map("_id") @db.ObjectId
  purchaseNumber   String              @unique
  supplierName     String
  supplierEmail    String?
  supplierPhone    String?
  productVariantId String              @db.ObjectId
  productVariant   ProductVariant      @relation(fields: [productVariantId], references: [id])
  quantity         Int
  receivedQuantity Int                 @default(0)
  unitCost         Float
  totalCost        Float
  status           PurchaseOrderStatus @default(pending)
  notes            String?
  orderedAt        DateTime            @default(now())
  receivedAt       DateTime?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  @@index([productVariantId])
  @@index([status])
  @@index([orderedAt])
}
